APP_NAME=Named
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+asyncmy://named:named@127.0.0.1:3306/named?charset=utf8mb4
AUTH_SECRET=dev-only-change-me
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_MAX_PER_HOUR=10
AUTH_SESSION_TTL_DAYS=30
AUTH_DEV_LOG_CODES=true
AI_MODEL=deepseek:deepseek-flash
AI_PROMPT_VERSION=discover-v3
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE=
DASHSCOPE_REGION=cn-beijing
# Use the WebSocket URL of the workspace where the TTS model is enabled.
DASHSCOPE_WEBSOCKET_URL=
TTS_MODEL=qwen-audio-3.1-tts-flash
TTS_VOICE_US=Cindy_v3.1
TTS_VOICE_UK=Emily_v3.1
TTS_VOICE_TALK=Cindy_v3.1
TTS_FORMAT=mp3
TTS_RATE=1.0
# Enable this ASR model for the same DashScope workspace.
STT_MODEL=qwen-audio-3.1-asr-flash
STT_TIMEOUT_SECONDS=60
TALK_AUDIO_TTL_SECONDS=604800
EXPERIENCE_DEBOUNCE_SECONDS=3
EXPERIENCE_MAX_ATTEMPTS=3
EXPERIENCE_CONFIDENCE_THRESHOLD=0.6
EXPERIENCE_WORKER_INTERVAL_SECONDS=1
EXPERIENCE_WORKER_ENABLED=true
MEDIA_ROOT=media
MEDIA_URL_PREFIX=/api/v1/audio
IMAGE_URL_PREFIX=/api/v1/images
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_DIMENSION=2048
RATE_LIMIT_DISCOVER_PER_MINUTE=30
RATE_LIMIT_TALK_PER_MINUTE=60
